.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.steps {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.step {
  font-size: 24rpx;
  color: #9ca3af;
}

.step.on {
  color: #3b82f6;
  font-weight: 600;
}

.step.done {
  color: #6b7280;
}

.sep {
  margin: 0 12rpx;
  color: #d1d5db;
  font-size: 24rpx;
}

.path {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.path-item {
  font-size: 24rpx;
  color: #374151;
  background: #f3f4f6;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.back {
  margin-left: auto;
  font-size: 24rpx;
  color: #3b82f6;
}

.hint {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.book-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.book-item.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.book-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.check {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 600;
  margin-left: 16rpx;
}

.arrow {
  font-size: 32rpx;
  color: #9ca3af;
  margin-left: 16rpx;
}

.empty {
  margin-top: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
