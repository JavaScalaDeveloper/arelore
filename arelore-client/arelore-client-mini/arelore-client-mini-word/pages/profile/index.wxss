.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f3f4f6;
}

.page-main {
  flex: 1;
}

.network-banner {
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #fff7ed;
  border-radius: 24rpx;
  border: 1rpx solid #fdba74;
}

.network-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #9a3412;
}

.network-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #c2410c;
  line-height: 1.5;
}

.network-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a3412;
  opacity: 0.75;
  word-break: break-all;
}

.network-retry {
  margin-top: 16rpx;
  background: #ea580c;
  color: #ffffff;
}

.user-card {
  padding: 36rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.user-card.logged {
  display: flex;
  align-items: center;
  background: linear-gradient(145deg, #eff6ff 0%, #ffffff 70%);
}

.user-card.guest {
  display: flex;
  flex-direction: column;
}

.guest-top {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #e5e7eb;
  flex-shrink: 0;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  font-size: 36rpx;
  font-weight: 700;
  background: #dbeafe;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.45;
}

.login-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
}

.login-btn::after {
  border: none;
}

.stats-card {
  margin-top: 20rpx;
  padding: 32rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d4ed8;
  line-height: 1;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #e5e7eb;
}

.menu-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.menu-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.menu-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.menu-arrow {
  font-size: 36rpx;
  color: #9ca3af;
  line-height: 1;
}

.logout-btn {
  margin-top: 40rpx;
  background: #ffffff;
  color: #ef4444;
  border-radius: 18rpx;
  font-size: 28rpx;
  border: 2rpx solid #fecaca;
}

.logout-btn::after {
  border: none;
}
