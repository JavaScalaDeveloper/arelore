<view class="page">
  <view class="page-main">
    <view class="network-banner" wx:if="{{networkError}}">
      <text class="network-title">网络不通</text>
      <text class="network-desc">{{networkErrorMessage}}</text>
      <text class="network-meta" wx:if="{{apiEnv}}">当前环境：{{apiEnv}}</text>
      <text class="network-meta" wx:if="{{apiBaseUrl}}">接口：{{apiBaseUrl}}</text>
      <button class="network-retry" size="mini" bindtap="onRetryNetwork">重试</button>
    </view>

    <view class="user-card logged" wx:if="{{user}}">
      <image class="avatar" wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view class="avatar placeholder" wx:else>词</view>
      <view class="user-meta">
        <text class="nickname">{{user.nickName}}</text>
        <text class="tip">学习进度已同步</text>
      </view>
    </view>

    <view class="user-card guest" wx:else>
      <view class="guest-top">
        <view class="avatar placeholder">游</view>
        <view class="user-meta">
          <text class="nickname">游客</text>
          <text class="tip">可先浏览单词书；登录后同步进度与设置</text>
        </view>
      </view>
      <button class="login-btn" bindtap="onLogin">登录同步进度</button>
    </view>

    <view class="stats-card" wx:if="{{user}}">
      <view class="stat-item">
        <text class="stat-value">{{totalStudyDays}}</text>
        <text class="stat-label">累计学习</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{consecutiveStudyDays}}</text>
        <text class="stat-label">连续学习</text>
      </view>
    </view>

    <view class="menu-card" bindtap="onSettings">
      <view class="menu-icon">设</view>
      <view class="menu-main">
        <text class="menu-label">设置背词模式</text>
        <text class="menu-sub" wx:if="{{user}}">当前：{{studyModeLabel}}</text>
        <text class="menu-sub" wx:else>登录后可调整听词 / 看词 / 听写</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{user}}" bindtap="onLogout">退出登录</button>
</view>
