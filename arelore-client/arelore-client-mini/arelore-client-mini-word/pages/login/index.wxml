<view class="page">
  <view class="card">
    <view class="badge">可选登录</view>
    <text class="title">登录同步进度</text>
    <text class="sub">用于保存单词本与学习记录</text>
    <text class="hint">不会强制索取手机号、头像或昵称。可先浏览单词书，需要同步时再登录。</text>
    <button class="btn" loading="{{loading}}" bindtap="onWechatQuickLogin">
      微信登录
    </button>
    <button class="skip" bindtap="onSkip">暂不登录，继续浏览</button>
  </view>
</view>
