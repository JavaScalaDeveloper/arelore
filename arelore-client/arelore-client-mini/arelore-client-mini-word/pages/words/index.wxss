.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero-banner {
  position: relative;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1d4ed8 0%, #3b82f6 48%, #60a5fa 100%);
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.28);
  overflow: hidden;
}

.hero-banner::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-banner.soft {
  background: linear-gradient(145deg, #eff6ff 0%, #ffffff 100%);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.hero-banner.soft .hero-title {
  color: #111827;
}

.hero-banner.soft .hero-desc {
  color: #6b7280;
}

.hero-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #eff6ff;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-desc {
  display: block;
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: rgba(239, 246, 255, 0.92);
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
}

.panel-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.book-icon {
  background: #eff6ff;
  color: #2563eb;
}

.panel-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.panel-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.panel-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.panel-action {
  display: flex;
  align-items: center;
  color: #3b82f6;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.panel-action-text {
  font-size: 26rpx;
}

.panel-chevron {
  margin-left: 2rpx;
  font-size: 36rpx;
  line-height: 1;
}

.action-stack {
  margin-top: 28rpx;
}

.btn-primary {
  margin: 0;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  margin: 20rpx 0 0;
  background: #ffffff;
  color: #1e40af;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbeafe;
  line-height: 1.3;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.btn-secondary-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #93c5fd;
}

.login-nudge {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.login-nudge-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.login-nudge-link {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.book-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.book-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.book-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.book-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-action {
  display: flex;
  align-items: center;
  color: #3b82f6;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.book-switch {
  font-size: 28rpx;
}

.book-arrow {
  margin-left: 4rpx;
  font-size: 40rpx;
  line-height: 1;
}

.progress-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.progress-pct {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563eb;
}

.progress-track {
  margin-top: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #60a5fa 0%, #2563eb 100%);
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.progress-meta-text {
  font-size: 24rpx;
  color: #6b7280;
}

.cards {
  display: flex;
  margin-top: 24rpx;
}

.card {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.22);
}

.card + .card {
  margin-left: 18rpx;
}

.learn {
  background: linear-gradient(145deg, #3b82f6 0%, #1d4ed8 100%);
}

.review {
  background: linear-gradient(145deg, #8b5cf6 0%, #6d28d9 100%);
  box-shadow: 0 14rpx 30rpx rgba(109, 40, 217, 0.22);
}

.card-eyebrow {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

.card-title {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  margin-top: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-num.muted {
  opacity: 0.75;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.state-card {
  padding: 56rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  text-align: center;
}

.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #3b82f6;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

.state-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.state-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.state-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
  word-break: break-all;
}

.mode-chip {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
}

.mode-chip.listen {
  background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%);
}

.mode-chip-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mode-chip-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.mode-chip-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.mode-chip.listen .mode-chip-value {
  color: #0f766e;
}

.mode-chip-arrow {
  font-size: 36rpx;
  color: #9ca3af;
  line-height: 1;
}

.start-btn {
  margin-top: 24rpx;
}
