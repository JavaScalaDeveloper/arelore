.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.book-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.book-meta {
  display: flex;
  flex-direction: column;
}

.book-label {
  font-size: 24rpx;
  color: #6b7280;
}

.book-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.book-action {
  display: flex;
  align-items: center;
  color: #3b82f6;
}

.book-switch {
  font-size: 28rpx;
}

.book-arrow {
  margin-left: 4rpx;
  font-size: 40rpx;
  line-height: 1;
}

.cards {
  display: flex;
  margin-top: 32rpx;
}

.card {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.card + .card {
  margin-left: 20rpx;
}

.learn {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
}

.review {
  background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
}

.card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.stats {
  display: flex;
  margin-top: 28rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-num.muted {
  opacity: 0.75;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.empty-text {
  display: block;
  margin-bottom: 24rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.state-card {
  padding: 48rpx 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.state-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.state-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.primary-btn {
  margin-top: 36rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.start-btn {
  margin-top: 40rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}
