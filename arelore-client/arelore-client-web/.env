# 仅作本地兜底；正式启动请用 start.sh，会写入 .env.development.local 覆盖本文件
# test → web:3001 api:http://test.arelore.com:8281/api（对齐 application-test.yml:8281）
# prd  → web:3000 api:http://www.arelore.com:8081/api（对齐 application-prd.yml:8081）
# dev  → web:3300 api:http://localhost:8081/api
PORT=3300
REACT_APP_API_BASE_URL=http://localhost:8081/api
# 类型/ESLint 问题不阻断页面、不弹编译错误层（细节看终端）
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=true
